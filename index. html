<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Surprise 💖</title>

<style>
body{
  margin:0;
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(135deg,#ffd6e7,#fff);
  font-family:Arial,sans-serif;
  text-align:center;
}

.box{
  background:white;
  padding:35px;
  border-radius:25px;
  width:85%;
  max-width:400px;
  box-shadow:0 10px 30px #0002;
}

h1{
  color:#e91e63;
}

input{
  padding:12px;
  width:80%;
  border-radius:20px;
  border:1px solid #ddd;
  text-align:center;
}

button{
  margin-top:15px;
  padding:12px 30px;
  border:none;
  border-radius:25px;
  background:#e91e63;
  color:white;
}

.page{
  display:none;
}
</style>

</head>

<body>

<div class="box" id="page1">
<h1>🔐 First Surprise</h1>
<p>Unlock the first memory 💌</p>
<input id="pass1" placeholder="Password">
<br>
<button onclick="nextPage(1)">Open</button>
</div>


<div class="box page" id="page2">
<h1>🔐 Second Surprise</h1>
<p>You are getting closer ✨</p>
<input id="pass2" placeholder="Password">
<br>
<button onclick="nextPage(2)">Open</button>
</div>


<div class="box page" id="page3">
<h1>🔐 Third Surprise</h1>
<p>One more step my love ❤️</p>
<input id="pass3" placeholder="Password">
<br>
<button onclick="nextPage(3)">Open</button>
</div>


<div class="box page" id="page4">
<h1>🔐 Final Lock</h1>
<p>Your biggest surprise is waiting 🎁</p>
<input id="pass4" placeholder="Password">
<br>
<button onclick="nextPage(4)">Open</button>
</div>


<div class="box page" id="birthday">
<h1>🎂 Happy Birthday Mohammad Naime 💖</h1>

<p>
Welcome to your little surprise ❤️<br><br>

No matter how far the distance is,
you will always have a special place in my heart.

May Allah bless you with happiness,
success and endless beautiful moments.

I love you ❤️
</p>

</div>


<script>

let passwords=[
"",
"naime1",
"naime2",
"naime3",
"Monaireventiseiukbd"
];


function nextPage(num){

let input=document.getElementById("pass"+num).value;

if(input===passwords[num]){

document.getElementById("page"+num).style.display="none";

if(num===4){
document.getElementById("birthday").style.display="block";
}

else{
document.getElementById("page"+(num+1)).style.display="block";
}

}

else{

alert("Wrong password 😭");

}

}

</script>

</body>
</html>